{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun swift-format:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(plutil -lint:*)"
    ],
    "deny": [
      "Read(./Paxo/Secrets.swift)",
      "Read(./.env)",
      "Read(./**/.env.*)",
      "Read(./proxy-vercel/.vercel/**)",
      "Read(./proxy/.wrangler/**)"
    ]
  }
}
